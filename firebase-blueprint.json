        "country": { "type": "string" },
        "abv": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "rules": {
        "read": true,
        "write": "request.auth != null && (request.auth.token.email == 'barrackratemo199@gmail.com' || request.auth.token.role == 'admin' || exists(/databases/$(database)/documents/admins/$(request.auth.uid)))"
      }
    },
